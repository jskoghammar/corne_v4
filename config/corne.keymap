#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define LAYER_BASE 0
#define LAYER_SYM 1
#define LAYER_NAV 2
#define LAYER_BT 3

/*
 * Layer signals. Layer index N emits a bare F13+N on entry so keylens can show
 * the matching overlay. macOS binds none of F13-F24, which is the whole point:
 * no other application can react to them. Naked modifiers were used for this
 * until it turned out five consecutive RSHFT taps trip macOS Sticky Keys and a
 * naked RGUI tap opens the Start menu inside a Windows VM.
 *
 * Releasing a layer taps SIG_BASE, the index-0 signal, so keylens can hide the
 * overlay on release instead of timing it out. Every layer is a momentary
 * hold, so entry alone does not tell it how long the hold lasts.
 *
 * keymap-drawer/layers.json is generated from these pairings and CI asserts
 * each one matches its layer index. Keep them in step.
 */
#define SIG_BASE F13
#define SIG_SYM F14
#define SIG_NAV F15
#define SIG_BT F16

/ {
        behaviors {
                compatible = "zmk,behaviors";

                /*
                 * Apostrophe shares the right-hand shift key. Stock &mt is
                 * hold-preferred, which fires the hold the moment any other key
                 * goes down -- "don't" comes out "donT". require-prior-idle-ms
                 * forces the tap when another key was pressed within the last
                 * 150ms, so mid-word apostrophes always type, while a
                 * deliberate reach after a pause still shifts.
                 */
                qshft: quote_shift {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "balanced";
                        tapping-term-ms = <200>;
                        quick-tap-ms = <175>;
                        require-prior-idle-ms = <150>;
                        bindings = <&kp>, <&kp>;
                };

                /*
                 * Swedish characters, emitted natively so they work with no
                 * application running. On British-PC, Option+A is a direct
                 * aring, but adiaeresis and odiaeresis need the Option+U dead
                 * key -- and Option must be *released* before the following
                 * letter. Holding it through both gives "..a" instead. A macro
                 * gets that right; fingers cannot.
                 *
                 * keep-mods = <0> matters: the shifted morphs supply their own
                 * shift, and a leaked shift would turn Option+U into a
                 * different dead key.
                 */
                sv_aring: sv_aring {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&kp LA(A)>, <&kp LS(LA(A))>;
                        mods = <(MOD_LSFT|MOD_RSFT)>;
                        keep-mods = <0>;
                };

                sv_adiaer: sv_adiaer {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&sv_adiaer_lo>, <&sv_adiaer_up>;
                        mods = <(MOD_LSFT|MOD_RSFT)>;
                        keep-mods = <0>;
                };

                sv_odiaer: sv_odiaer {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&sv_odiaer_lo>, <&sv_odiaer_up>;
                        mods = <(MOD_LSFT|MOD_RSFT)>;
                        keep-mods = <0>;
                };

                comma_excl: comma_excl {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&kp COMMA>, <&kp LS(N1)>;
                        mods = <(MOD_LSFT|MOD_RSFT)>;
                        keep-mods = <0>;
                };

                dot_dquote: dot_dquote {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&kp DOT>, <&kp LS(N2)>;
                        mods = <(MOD_LSFT|MOD_RSFT)>;
                        keep-mods = <0>;
                };

                pipe_bslash_swap: pipe_bslash_swap {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&kp LS(NON_US_BSLH)>, <&kp NON_US_BSLH>;
                        mods = <(MOD_LSFT|MOD_RSFT)>;
                        keep-mods = <0>;
                };
        };

        macros {
                /*
                 * Momentary layer hold that also emits the layer's signal.
                 * Both parameters are explicit at the call site so the CI check
                 * can verify the signal matches the layer index.
                 *
                 * tap-ms must stay non-zero: the behavior queue only yields
                 * between press and release when the wait is > 0
                 * (behavior_queue.c), so a zero-length tap never reaches the
                 * host.
                 */
                lyr: lyr {
                        compatible = "zmk,behavior-macro-two-param";
                        #binding-cells = <2>;
                        wait-ms = <0>;
                        tap-ms = <30>;
                        bindings
                                = <&macro_param_1to1>
                                , <&macro_press &mo MACRO_PLACEHOLDER>
                                , <&macro_param_2to1>
                                , <&macro_tap &kp MACRO_PLACEHOLDER>
                                , <&macro_pause_for_release>
                                , <&macro_param_1to1>
                                , <&macro_release &mo MACRO_PLACEHOLDER>
                                , <&macro_tap &kp SIG_BASE>
                                ;
                };

                sv_adiaer_lo: sv_adiaer_lo {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <0>;
                        tap-ms = <30>;
                        bindings = <&kp LA(U)>, <&kp A>;
                };

                sv_adiaer_up: sv_adiaer_up {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <0>;
                        tap-ms = <30>;
                        bindings = <&kp LA(U)>, <&kp LS(A)>;
                };

                sv_odiaer_lo: sv_odiaer_lo {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <0>;
                        tap-ms = <30>;
                        bindings = <&kp LA(U)>, <&kp O>;
                };

                sv_odiaer_up: sv_odiaer_up {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <0>;
                        tap-ms = <30>;
                        bindings = <&kp LA(U)>, <&kp LS(O)>;
                };

                hrs: hrs {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <0>;
                        tap-ms = <30>;
                        bindings = <&kp LS(LG(J))>;
                };

                hrm: hrm {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <0>;
                        tap-ms = <30>;
                        bindings = <&kp LA(SPACE)>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                base_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
// | SHFT |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  | '/SH |
// | CTRL |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   | ,!  | ."  |  /  |  -   |
//                    | GUI | NAV | SPC |   | ENT | SYM  | ESC |
                        display-name = "Base";
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U &kp I       &kp O       &kp P    &kp BSPC
   &kp LSHFT &kp A &kp S &kp D &kp F &kp G   &kp H &kp J &kp K       &kp L       &kp SEMI &qshft RSHFT SQT
   &kp LCTRL &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M &comma_excl &dot_dquote &kp FSLH &kp MINUS
          &kp LGUI &lyr LAYER_NAV SIG_NAV    &kp SPACE   &kp RET &lyr LAYER_SYM SIG_SYM   &kp ESC
                        >;
                };

                symbol_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  $  |  (  |  )  |  [  |  ]  |  å   |
// | SHFT |  6  |  7  |  8  |  9  |  0  |   |  =  |  +  |  %  |  '  |  ö  |  ä   |
// | CTRL | ALT |     |     |     |  @  |   |  ^  |  &  |  *  |  `  |  #  | BKSP |
//                    | GUI |     | SPC |   | ENT |     |     |
//
// Row 0 col 11, row 1 cols 10-11 hold a-ring, o-diaeresis and a-diaeresis at the
// positions they occupy on a Swedish keyboard: a-ring right of P, then the two
// keys right of L. That displaces # and backspace to row 2, and means row 1 col
// 11 is not shift on this layer -- see agents.md.
//
// Row 2 col 5 sends Shift+' directly, since @ was otherwise only reachable as a
// three-key chord: base's ' is qshft, whose hold IS the shift, so Sym is the
// only place @ can get a key of its own.
                        display-name = "Sym";
                        bindings = <
   &kp TAB   &kp N1   &kp N2 &kp N3 &kp N4 &kp N5   &kp LS(N4) &kp LS(N9) &kp LS(N0) &kp LBKT  &kp RBKT        &sv_aring
   &kp LSHFT &kp N6   &kp N7 &kp N8 &kp N9 &kp N0   &kp EQUAL  &kp PLUS   &kp LS(N5) &kp SQT   &sv_odiaer      &sv_adiaer
   &kp LCTRL &kp LALT &none  &none  &none  &kp LS(SQT) &kp LS(N6) &kp LS(N7) &kp LS(N8) &kp GRAVE &kp NON_US_HASH &kp BSPC
          &kp LGUI &trans                           &kp SPACE  &kp RET &trans        &trans
                        >;
                };

                nav_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  BT |     |     |     |     |   | TL  | TR  |     |     |     | BKSP |
// | SHFT | CTR | MAX | DSP | HLF |     |   | LFT | DWN |  UP | RGT |     | SHFT |
// | CTRL |     | HRS | HRM |     |     |   | BL  | BR  |S-HOM|S-END| "|" |      |
//                    | GUI | ALT | SPC |   | ENT |     |     |
//
// Window management is a held modifier plus a direction, not a combo and not a
// decoder ring -- the Corne emits exactly the chord a bare keyboard emits.
//   HLF (row 1 col 4) holds Ctrl+Alt: arrows snap halves, TL/TR/BL/BR snap corners.
//   DSP (row 1 col 3) holds Ctrl+Alt+Gui: arrows move the window between displays.
//   CTRL (row 2 col 0) is already there: arrows switch macOS Spaces.
// All of these are Rectangle's factory bindings. Nothing here needs Rectangle to
// be configured, only installed.
                        display-name = "Nav";
                        bindings = <
   &kp TAB   &lyr LAYER_BT SIG_BT &none &none            &none         &none   &kp U    &kp I    &none        &none      &none             &kp BSPC
   &kp LSHFT &kp LC(LA(C)) &kp LC(LA(RET)) &kp LC(LA(LGUI)) &kp LC(LALT) &none  &kp LEFT &kp DOWN &kp UP       &kp RIGHT  &none             &kp RSHFT
   &kp LCTRL &trans        &hrs            &hrm             &trans       &trans &kp J    &kp K    &kp LS(HOME) &kp LS(END) &pipe_bslash_swap &none
          &kp LGUI &kp LALT                                 &kp SPACE    &kp RET &trans  &trans
                        >;
                };

                bt_layer {
// -----------------------------------------------------------------------------------------
// |  TAB | BT 1 | BT 2 | BT 3 | BT 4 | BT 5 |   |     |     |     |     |     | BKSP |
// |      |      |      |      |      |      |   |     |     |     |     |     |      |
// |      |      |      |      |      |      |   |     |     |     |     |     |      |
//                    |     |     |     |   |     |     |     |
                        display-name = "BT";
                        bindings = <
   &kp TAB   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &none &none &none &none &none &kp BSPC
   &none     &none        &none        &none        &none        &none          &none &none &none &none &none &none
   &none     &none        &none        &none        &none        &none          &none &none &none &none &none &none
                  &trans   &trans                                &trans      &trans  &trans         &trans
                        >;
                };
        };
};
